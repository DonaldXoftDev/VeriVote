# Application
APP_NAME=VeriVote
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string-in-production

# Database (SQLite default for local Sprint 0 prototyping; PostgreSQL for production)
DATABASE_URL=sqlite:///./verivote.db
# DATABASE_URL=postgresql+psycopg://verivote:verivote@localhost:5432/verivote

# CORS
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# SMTP / OTP Dispatch (configured in Sprint 1)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@verivote.local

# Initial Super-Admin Seeding (required only when running python -m app.seed_admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
